# Template for .env, which is git-ignored and never committed.
#
# `make up` (or any make target that uses docker compose) creates .env from
# this file on first run and fills in the two passwords with random values.
# To pick your own instead, copy this file to .env and set them yourself.
#
# Postgres and RabbitMQ create their users only on first boot, so after
# changing a password run `make clean && make up`.
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=
POSTGRES_DB=controlplane

RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=

HTTP_PORT=8000
LOG_LEVEL=info
RELAY_INTERVAL=500ms

WORKER_FAIL_RATE=0.0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
WORKER_DUPLICATE_RATE=0.0
WORKER_SKIP_IN_PROGRESS=false
