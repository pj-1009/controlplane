# Copy to .env to override. Every value has the same default in docker-compose.yml,
# so the stack runs without a .env file. These are local-only credentials.
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=controlplane

RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=REDACTED

HTTP_PORT=8000
LOG_LEVEL=info
RELAY_INTERVAL=500ms

WORKER_FAIL_RATE=0.0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
WORKER_DUPLICATE_RATE=0.0
WORKER_SKIP_IN_PROGRESS=false
